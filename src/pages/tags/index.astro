---
import Layout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getPostTags } from '../../utils/posts';

const posts = await getCollection('blog');
const tagCount: Record<string, number> = {};
posts.forEach(p => {
	getPostTags(p).forEach(tag => {
		tagCount[tag] = (tagCount[tag] || 0) + 1;
	});
});
const sorted = Object.entries(tagCount).sort((a, b) => a[0].localeCompare(b[0]));
---
<Layout title="Tags - Shu Hu" description="Blog tags">
	<div class="container tag-index">
		<div>
			<ul class="tag-list" itemprop="keywords">
				{sorted.map(([tag, count]) => (
					<li class="tag-list-item">
						<a class="tag-list-link" href={`/tags/${encodeURIComponent(tag)}/`} rel="tag">{tag}</a><span class="tag-list-count">{count}</span>
					</li>
				))}
			</ul>
		</div>
	</div>
</Layout>
