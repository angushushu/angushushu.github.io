---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import Layout from '../../layouts/BaseLayout.astro';
import Giscus from '../../components/Giscus.astro';
import {
	formatDateTime,
	getAbsoluteUrl,
	getPostDescription,
	getPostPath,
	getPostSlug,
	getPostTags,
	sortPostsNewest,
} from '../../utils/posts';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: getPostSlug(post) },
		props: post,
	}));
}

type Props = CollectionEntry<'blog'>;
const post = Astro.props as Props;

const allPosts = sortPostsNewest(await getCollection('blog'));
const idx = allPosts.findIndex(p => p.id === post.id);
const olderPost = idx < allPosts.length - 1 ? allPosts[idx + 1] : null;
const newerPost = idx > 0 ? allPosts[idx - 1] : null;

const { Content } = await import('astro:content').then(m => m.render(post));

const sortedTags = [...getPostTags(post)].sort();
const [dateStr, timeStr] = formatDateTime(post.data.date).split(' ');
const canonical = getAbsoluteUrl(getPostPath(post));
const description = getPostDescription(post);

const isProtected = !!post.data.password_id;
const passwordHint = post.data.password_hint || '';
---
<Layout title={`${post.data.title} - Shu Hu`} description={description} canonical={canonical}>
	<div class="container post-details" id="post-details">
		<div class="post-catalog" id="toc"></div>

		<div class="post-title">{post.data.title}</div>
		<div class="post-attach">
			<span class="post-pubtime">
				<i class="iconfont icon-updatetime mr-10" title="Update time"></i>{dateStr} {timeStr}
			</span>
			{sortedTags.length > 0 && (
				<span class="post-tags">
					<i class="iconfont icon-tags mr-10" title="tags"></i>
					{sortedTags.map(tag => (
						<span class="span--tag mr-8">
							<a href={`/tags/${encodeURIComponent(tag)}/`} title={tag}>#{tag}</a>
						</span>
					))}
				</span>
			)}
		</div>

		<div class="markdown-body" id="post-content">
			{isProtected ? (
				<div id="protected-content" style="display:none">
					<Content />
				</div>
			) : (
				<Content />
			)}
			{isProtected && (
				<div id="password-prompt" class="password-prompt" data-pw-id={post.data.password_id}>
					<svg class="password-lock" viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<rect x="4.5" y="10.5" width="15" height="10" rx="1.5"></rect>
						<path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"></path>
						<circle cx="12" cy="15" r="1.2" fill="currentColor" stroke="none"></circle>
					</svg>
					<p class="password-title">Password required</p>
					{passwordHint && (
						<p class="password-hint">
							<span class="password-hint-label">Hint</span>
							{passwordHint}
						</p>
					)}
					<div class="password-form">
						<input type="password" id="password-input" placeholder="Enter password" autocomplete="off" />
						<button id="password-submit">Unlock</button>
					</div>
					<p id="password-error" class="password-error">Incorrect password</p>
				</div>
			)}
		</div>

		<div class="prev-or-next">
			<div class="post-foot-next">
				{olderPost ? (
					<a href={getPostPath(olderPost)}>
						<i class="iconfont icon-chevronleft"></i>Prev
					</a>
				) : ''}
			</div>
			<div class="post-foot-prev">
				{newerPost ? (
					<a href={getPostPath(newerPost)}>
						Next<i class="iconfont icon-chevronright"></i>
					</a>
				) : ''}
			</div>
		</div>

		<div class="comments-container">
			<Giscus />
		</div>
	</div>

	<script>
		// Generate ToC
		(() => {
			const content = document.getElementById('post-content');
			if (!content) return;
			const headings = content.querySelectorAll('h1, h2, h3, h4');
			if (headings.length < 2) return;
			const toc = document.getElementById('toc');
			const ul = document.createElement('ul');
			ul.className = 'catalog-content';
			headings.forEach(h => {
				const id = (h.textContent || '').toLowerCase().replace(/[^a-z0-9\u4e00-\u9fff]+/g, '-').replace(/(^-|-$)/g, '');
				h.id = id;
				const li = document.createElement('li');
				li.innerHTML = `<a class="toc-link" href="#${id}">${h.textContent}</a>`;
				ul.appendChild(li);
			});
			toc.appendChild(ul);
			const links = toc.querySelectorAll('.toc-link');
			const observer = new IntersectionObserver(entries => {
				entries.forEach(e => {
					if (e.isIntersecting) {
						links.forEach(l => l.classList.remove('active'));
						const m = toc.querySelector(`a[href="#${e.target.id}"]`);
						if (m) m.classList.add('active');
					}
				});
			}, { rootMargin: '-80px 0px -80% 0px' });
			headings.forEach(h => observer.observe(h));
		})();

		// TOC scroll follow
		(() => {
			const toc = document.getElementById('toc');
			if (!toc) return;
			const origTop = toc.getBoundingClientRect().top + window.scrollY;
			let fixed = false;
			window.addEventListener('scroll', () => {
				if (window.scrollY > origTop - 20) {
					if (!fixed) {
						toc.style.position = 'fixed';
						toc.style.top = '20px';
						fixed = true;
					}
				} else {
					if (fixed) {
						toc.style.position = 'absolute';
						toc.style.top = '';
						fixed = false;
					}
				}
			});
		})();

		// Code copy
		(() => {
			document.querySelectorAll('pre').forEach(pre => {
				const btn = document.createElement('button');
				btn.className = 'pin-copy';
				btn.textContent = 'Copy';
				btn.onclick = () => {
					const code = pre.querySelector('code')?.textContent || '';
					navigator.clipboard.writeText(code).then(() => { btn.textContent = 'Copied!'; setTimeout(() => btn.textContent = 'Copy', 1500); });
				};
				pre.style.position = 'relative';
				pre.appendChild(btn);
			});
		})();

	</script>
	{isProtected && (
		<script is:inline>
			// 构建时 scripts/encrypt-protected.mjs 把正文替换成了 AES-256-GCM 密文
			// （data-payload = v1.<salt>.<iv>.<ciphertext+tag>，均为 base64），
			// 这里用输入的密码派生密钥解密；密码错误时 GCM 校验失败，解密本身即为验证。
			(function () {
				var promptEl = document.getElementById('password-prompt');
				var contentEl = document.getElementById('protected-content');
				var inputEl = document.getElementById('password-input');
				var errorEl = document.getElementById('password-error');
				var submitEl = document.getElementById('password-submit');

				function b64ToBytes(b64) {
					var bin = atob(b64);
					var bytes = new Uint8Array(bin.length);
					for (var i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
					return bytes;
				}

				async function unlock(password) {
					var parts = (promptEl.getAttribute('data-payload') || '').split('.');
					if (parts.length !== 4 || parts[0] !== 'v1') throw new Error('bad payload');
					var iterations = parseInt(promptEl.getAttribute('data-iter'), 10) || 600000;
					var baseKey = await crypto.subtle.importKey(
						'raw',
						new TextEncoder().encode(password),
						'PBKDF2',
						false,
						['deriveKey']
					);
					var key = await crypto.subtle.deriveKey(
						{ name: 'PBKDF2', salt: b64ToBytes(parts[1]), iterations: iterations, hash: 'SHA-256' },
						baseKey,
						{ name: 'AES-GCM', length: 256 },
						false,
						['decrypt']
					);
					var plain = await crypto.subtle.decrypt(
						{ name: 'AES-GCM', iv: b64ToBytes(parts[2]) },
						key,
						b64ToBytes(parts[3])
					);
					contentEl.innerHTML = new TextDecoder().decode(plain);
					contentEl.style.display = '';
					promptEl.style.display = 'none';
					fixDisplayMath();
				}

				// 与旧版保持一致：解锁后把只含一个 katex 公式的段落包成 katex-display 以正确居中
				function fixDisplayMath() {
					contentEl.querySelectorAll('p').forEach(function (p) {
						var children = Array.from(p.childNodes);
						var nonWs = children.filter(function (c) { return !(c.nodeType === 3 && /^\s*$/.test(c.textContent)); });
						if (nonWs.length !== 1) return;
						var el = nonWs[0];
						if (el.nodeType !== 1 || el.tagName !== 'SPAN' || !el.classList.contains('katex')) return;
						var wrapper = document.createElement('div');
						wrapper.className = 'katex-display';
						wrapper.appendChild(el);
						p.parentNode.replaceChild(wrapper, p);
					});
				}

				function verify() {
					var password = inputEl.value;
					if (!password) return;
					unlock(password).catch(function () {
						errorEl.classList.add('visible');
						var form = promptEl.querySelector('.password-form');
						form.classList.remove('shake');
						void form.offsetWidth; // 重置动画，让连续输错也能再次抖动
						form.classList.add('shake');
					});
				}

				submitEl.onclick = verify;
				inputEl.onkeydown = function (e) {
					if (e.key === 'Enter') verify();
				};
			})();
		</script>
	)}
</Layout>
